{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:metadata:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "published",
    "title"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "published": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^<>\\x00-\\x1f]*$"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>\\x00-\\x1f]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^<>\\x00-\\x1f]*$"
    },
    "icon": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:png|jpg|jpeg|webp)$"
        }
      ]
    },
    "technologies": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[^<>\\x00-\\x1f]*$"
      }
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^<>\\x00-\\x1f]*$"
    },
    "status": {
      "enum": [
        "in_development",
        "maintained",
        "completed",
        "archived",
        "unspecified"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "demo_url": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      ]
    },
    "source_url": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      ]
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "highlights": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^<>\\x00-\\x1f]*$"
          }
        }
      }
    }
  }
}
